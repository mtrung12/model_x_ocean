             ══════════════════════════════════════════════════════ -->
        <mxCell id="profiler_box" value="&lt;b&gt;Psychological Profiler&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;fontColor=#ffffff;strokeColor=#2a4a8a;strokeWidth=2;arcSize=10;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="225" width="220" height="42" as="geometry"/>
        </mxCell>

        <!-- Profiler internals group -->
        <mxCell id="profiler_internals" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eef8;strokeColor=#4472C4;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="282" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="pi_1" value="NEO-PI-R Schema&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;5 traits × 6 facets = 30 facets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bdd7ee;strokeColor=#4472C4;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="90" y="294" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pi_2" value="Signal Vocab&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;high / mod / low / none / n/e&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bdd7ee;strokeColor=#4472C4;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="218" y="294" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pi_lbl" value="LLM-Prompted Facet Extraction (GPT-4o)" style="text;html=1;align=center;fontSize=9;fontColor=#444;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="344" width="260" height="30" as="geometry"/>
        </mxCell>

        <!-- Arrow: profiler → profile -->
        <mxCell id="arr_prof_profile" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4472C4;strokeWidth=2;" edge="1" source="profiler_internals" target="profile_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Structured Profile output -->
        <mxCell id="profile_box" value="&lt;b&gt;Structured Profile&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;30-facet vector + evidence strings&lt;/font&gt;" style="shape=parallelogram;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;strokeWidth=2;arcSize=5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════
             OFFLINE: Embedding + Index
             ══════════════════════════════════════════════════════ -->
        <mxCell id="arr_profile_embed" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ED7D31;strokeWidth=2;" edge="1" source="profile_box" target="embed_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="embed_box" value="&lt;b&gt;Profile Embedding&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Sentence encoder → dense vector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7D31;fontColor=#fff;strokeColor=#b85a00;strokeWidth=2;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="220" height="44" as="geometry"/>
        </mxCell>

        <!-- Facet vector box (parallel) -->
        <mxCell id="facet_vec_box" value="&lt;b&gt;Facet Vector Encoding&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;φ(p) ∈ ℝ³⁰, L2-normalised&lt;br/&gt;high→+1, mod→+0.5, low→-1, none/n/e→0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#ED7D31;strokeWidth=1.5;arcSize=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="574" width="260" height="56" as="geometry"/>
        </mxCell>

        <!-- Arrow embed → facet -->
        <mxCell id="arr_embed_facet" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ED7D31;strokeWidth=1.5;" edge="1" source="embed_box" target="facet_vec_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FAISS Index -->
        <mxCell id="faiss_box" value="&lt;b&gt;FAISS ANN Index&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Profile embeddings&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#c0392b;strokeWidth=2;fontSize=11;arcSize=10;size=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="120" height="68" as="geometry"/>
        </mxCell>

        <!-- Facet Matrix Store -->
        <mxCell id="facet_store" value="&lt;b&gt;Facet Matrix Store&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;φ vectors + labels&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#c0392b;strokeWidth=2;fontSize=11;arcSize=10;size=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="650" width="120" height="68" as="geometry"/>
        </mxCell>

        <!-- Arrows facet vec → stores -->
        <mxCell id="arr_fv_faiss" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c0392b;strokeWidth=1.5;" edge="1" source="facet_vec_box" target="faiss_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_fv_store" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c0392b;strokeWidth=1.5;" edge="1" source="facet_vec_box" target="facet_store" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>


        <!-- ══════════════════════════════════════════════════════
             ONLINE: Test Essay Input
             ══════════════════════════════════════════════════════ -->
        <mxCell id="test_essay" value="&lt;b&gt;Test Essay&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;(unlabelled)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2efda;strokeColor=#70AD47;strokeWidth=2;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="120" width="160" height="52" as="geometry"/>
        </mxCell>

        <!-- Arrow: test essay → online profiler -->
        <mxCell id="arr_test_onprof" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4472C4;strokeWidth=2;" edge="1" source="test_essay" target="online_profiler" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Online Profiler (same component, applied to test essay) -->
        <mxCell id="online_profiler" value="&lt;b&gt;Psychological Profiler&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;(same model, label-blind)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;fontColor=#ffffff;strokeColor=#2a4a8a;strokeWidth=2;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="222" width="200" height="46" as="geometry"/>
        </mxCell>

        <!-- Test Profile output -->
        <mxCell id="test_profile" value="&lt;b&gt;Test Profile&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;30-facet + embedding + φ vector&lt;/font&gt;" style="shape=parallelogram;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;strokeWidth=2;arcSize=5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="310" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="arr_onprof_tprof" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4472C4;strokeWidth=2;" edge="1" source="online_profiler" target="test_profile" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════
             ONLINE: Hybrid Retrieval (per trait)
             ══════════════════════════════════════════════════════ -->
        <mxCell id="hybrid_box" value="&lt;b&gt;Hybrid Retrieval (per trait τ)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7D31;fontColor=#fff;strokeColor=#b85a00;strokeWidth=2;arcSize=10;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="410" width="240" height="42" as="geometry"/>
        </mxCell>

        <!-- Hybrid internals -->
        <mxCell id="hybrid_inner" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#ED7D31;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="462" width="280" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="hi_dense" value="Dense sim&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;FAISS ANN&lt;br/&gt;→ candidate pool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#ED7D31;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="480" y="474" width="110" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="hi_facet" value="Trait-masked facet sim&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;φ[S_τ] cosine&lt;br/&gt;re-rank&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#ED7D31;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="620" y="474" width="118" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="hi_score" value="score_τ(q,d) = β_τ · sim_dense + γ_τ · sim_facet    (γ_τ &gt; β_τ)" style="text;html=1;align=center;fontSize=9;fontColor=#333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="524" width="280" height="36" as="geometry"/>
        </mxCell>

        <!-- Arrows to hybrid -->
        <mxCell id="arr_tprof_hybrid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ED7D31;strokeWidth=2;" edge="1" source="test_profile" target="hybrid_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cross-phase arrows: stores → hybrid -->
        <mxCell id="arr_faiss_hybrid" value="query" style="edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;strokeColor=#c0392b;strokeWidth=1.5;dashed=1;fontStyle=2;fontSize=9;" edge="1" source="faiss_box" target="hi_dense" parent="1">
