        </mxCell>
        <mxCell id="arr_store_hybrid" value="rerank" style="edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;strokeColor=#c0392b;strokeWidth=1.5;dashed=1;fontStyle=2;fontSize=9;" edge="1" source="facet_store" target="hi_facet" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="718"/>
              <mxPoint x="280" y="770"/>
              <mxPoint x="679" y="770"/>
              <mxPoint x="679" y="496"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Top-k exemplars (trait-sliced) -->
        <mxCell id="topk_box" value="&lt;b&gt;Top-k Exemplars (trait-sliced)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;6 facets of τ + evidence + label (k=3 default)&lt;/font&gt;" style="shape=parallelogram;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6a800;strokeWidth=2;arcSize=5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="590" width="260" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="arr_hybrid_topk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ED7D31;strokeWidth=2;" edge="1" source="hybrid_inner" target="topk_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>


        <!-- ══════════════════════════════════════════════════════
             ONLINE: Reasoned Inference
             ══════════════════════════════════════════════════════ -->
        <mxCell id="inf_box" value="&lt;b&gt;Reasoned Inference (LLM)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;fontColor=#fff;strokeColor=#3a6e1a;strokeWidth=2;arcSize=10;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="240" height="42" as="geometry"/>
