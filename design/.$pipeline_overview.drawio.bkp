  <!-- ============================================================
       DIAGRAM 1 – END-TO-END PIPELINE (A4 landscape, 190 mm wide)
       Three-panel view: Offline Phase | Online Phase
       ============================================================ -->
  <diagram id="pipeline-overview" name="Fig 3.1 – End-to-End Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1"
                  tooltips="1" connect="0" arrows="0" fold="0"
                  page="1" pageScale="1" pageWidth="1169" pageHeight="827"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ══════════════════════════════════════════════════════
             BACKGROUND BANDS
             ══════════════════════════════════════════════════════ -->

        <!-- Offline Phase band -->
        <mxCell id="band_offline" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f4ff;strokeColor=#b0c0e0;strokeWidth=1.5;dashed=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="360" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_offline" value="&lt;b&gt;OFFLINE PHASE&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#555&#39;&gt;(run once on training corpus)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#2a4080;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="360" height="36" as="geometry"/>
        </mxCell>

        <!-- Online Phase band -->
        <mxCell id="band_online" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5fff5;strokeColor=#90c090;strokeWidth=1.5;dashed=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="710" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_online" value="&lt;b&gt;ONLINE PHASE&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#555&#39;&gt;(run once per test essay)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#1a6020;" vertex="1" parent="1">
          <mxGeometry x="430" y="65" width="710" height="36" as="geometry"/>
        </mxCell>


        <!-- ══════════════════════════════════════════════════════
             COMPONENT LABELS (coloured side-bars)
             ══════════════════════════════════════════════════════ -->

        <!-- Component 1 label -->
        <mxCell id="comp1_label" value="① PROFILER" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#ffffff;fillColor=#4472C4;strokeColor=none;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="30" y="270" width="22" height="120" as="geometry"/>
        </mxCell>

        <!-- Component 2 label -->
        <mxCell id="comp2_label" value="② RAG INDEX" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#ffffff;fillColor=#ED7D31;strokeColor=none;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="22" height="120" as="geometry"/>
        </mxCell>

        <!-- Component 3 label (online) -->
        <mxCell id="comp3_label" value="③ REASONED INFERENCE" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#ffffff;fillColor=#70AD47;strokeColor=none;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="430" y="330" width="22" height="200" as="geometry"/>
        </mxCell>


        <!-- ══════════════════════════════════════════════════════
             OFFLINE: Training Corpus
             ══════════════════════════════════════════════════════ -->
        <mxCell id="train_corpus" value="&lt;b&gt;Training Corpus&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;N essays + OCEAN labels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472C4;strokeWidth=2;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow: corpus → profiler (offline) -->
        <mxCell id="arr_corpus_prof" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4472C4;strokeWidth=2;" edge="1" source="train_corpus" target="profiler_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════════
