        <mxCell id="pinner_trait" value="Trait definition&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;HIGH / LOW descriptors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="760" y="332" width="114" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pinner_ex" value="Retrieved exemplars&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;calibration anchors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="886" y="332" width="114" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pinner_essay" value="Test essay text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="114" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pinner_xml" value="XML output schema&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;system prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="886" y="380" width="114" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="pinner_chain" value="Structured reasoning chain:&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;&lt;evidence&gt; → &lt;facet_check&gt; → &lt;cue_tally&gt;&lt;br/&gt;→ &lt;example_alignment&gt; → &lt;verdict&gt; → &lt;label&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#70AD47;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="428" width="240" height="52" as="geometry"/>
        </mxCell>

        <!-- Arrows into inference -->
