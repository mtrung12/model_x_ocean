  <!-- ============================================================
       DIAGRAM 2 – PROFILER DETAIL
       ============================================================ -->
  <diagram id="profiler-detail" name="Fig 3.2 – Profiler Detail">
    <mxGraphModel dx="1100" dy="780" grid="0" gridSize="10" guides="1"
