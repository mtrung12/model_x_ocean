                  page="1" pageScale="1" pageWidth="1169" pageHeight="827"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title2" value="&lt;b&gt;&lt;font style=&#39;font-size:13px&#39;&gt;Figure 3.2 — Psychological Profiler: NEO-PI-R Facet Extraction&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1100" height="30" as="geometry"/>
        </mxCell>

        <!-- Essay input -->
        <mxCell id="p_essay" value="&lt;b&gt;Raw Essay&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472C4;strokeWidth=2;arcSize=30;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="140" height="48" as="geometry"/>
