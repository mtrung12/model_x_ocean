        <!-- LLM box -->
        <mxCell id="i_llm" value="&lt;b&gt;Language Model (LLM)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;fontColor=#fff;strokeColor=#3a6e1a;strokeWidth=2.5;arcSize=10;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="260" height="48" as="geometry"/>
        </mxCell>

        <!-- Prompt inputs -->
        <mxCell id="i_trtname" value="Trait name τ&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;+ HIGH / LOW definitions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="595" y="190" width="145" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="i_exmpl" value="Retrieved exemplars&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;calibration anchors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="752" y="190" width="145" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="i_essay2" value="Test essay text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="595" y="244" width="145" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="i_schema" value="XML output schema&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;(system prompt)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6efce;strokeColor=#70AD47;fontSize=10;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="752" y="244" width="145" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="arr_inputs_llm" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#70AD47;strokeWidth=1.5;fontStyle=2;fontSize=9;" edge="1" source="i_trtname" target="i_llm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_ex_llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#70AD47;strokeWidth=1.5;" edge="1" source="i_exmpl" target="i_llm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Reasoning chain -->
        <mxCell id="i_chain_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2efda;strokeColor=#70AD47;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="596" y="302" width="464" height="294" as="geometry"/>
        </mxCell>
        <mxCell id="i_chain_lbl" value="&lt;b&gt;Structured Reasoning Chain (XML)&lt;/b&gt;" style="text;html=1;align=center;fontSize=11;fontColor=#1a6020;" vertex="1" parent="1">
          <mxGeometry x="596" y="308" width="464" height="22" as="geometry"/>
        </mxCell>

        <!-- Chain steps -->
        <mxCell id="step1" value="&lt;tt&gt;&lt;evidence&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;Trait-relevant cues from essay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#70AD47;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="614" y="338" width="180" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="&lt;tt&gt;&lt;facet_check&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;Map cues to facets of τ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#70AD47;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="338" width="236" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="&lt;tt&gt;&lt;cue_tally&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;Count HIGH vs LOW cues&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#70AD47;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="614" y="396" width="180" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="&lt;tt&gt;&lt;example_alignment&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;Align with retrieved exemplars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#70AD47;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="396" width="236" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="&lt;tt&gt;&lt;verdict&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;Consistent with cue_tally&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;fontColor=#fff;strokeColor=#3a6e1a;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="614" y="454" width="180" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="&lt;tt&gt;&lt;label&gt;&lt;/tt&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;&lt;b&gt;high&lt;/b&gt; or &lt;b&gt;low&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;fontColor=#fff;strokeColor=#3a6e1a;fontSize=10;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="454" width="236" height="44" as="geometry"/>
        </mxCell>

        <!-- Sequential arrows -->
        <mxCell id="arr_s1s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3a6e1a;strokeWidth=1.5;" edge="1" source="step1" target="step2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_s2s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3a6e1a;strokeWidth=1.5;" edge="1" source="step2" target="step3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_s3s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3a6e1a;strokeWidth=1.5;" edge="1" source="step3" target="step4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_s4s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3a6e1a;strokeWidth=1.5;" edge="1" source="step4" target="step5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_s5s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3a6e1a;strokeWidth=2;" edge="1" source="step5" target="step6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="consistency_note" value="verdict must be consistent with cue_tally" style="text;html=1;align=center;fontSize=9;fontColor=#555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="596" y="504" width="464" height="18" as="geometry"/>
        </mxCell>

        <!-- Final output -->
        <mxCell id="i_out" value="&lt;b&gt;Predicted Label&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#fff&#39; style=&#39;font-size:13px&#39;&gt;high / low&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;(one per trait, 5 total)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a6020;fontColor=#fff;strokeColor=#0a3010;strokeWidth=2.5;arcSize=30;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="706" y="630" width="170" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="arr_chain_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1a6020;strokeWidth=2.5;" edge="1" source="i_chain_bg" target="i_out" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cross-diagram arrow: retrieval → inference -->
        <mxCell id="arr_ret_inf" value="trait-sliced&lt;br/&gt;exemplars" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d6a800;strokeWidth=2;fontStyle=1;fontSize=10;" edge="1" source="r_render" target="i_exmpl" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="710"/>
              <mxPoint x="900" y="710"/>
              <mxPoint x="900" y="250"/>
              <mxPoint x="824" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LLM arrow down to chain -->
        <mxCell id="arr_llm_chain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#70AD47;strokeWidth=2;" edge="1" source="i_llm" target="i_chain_bg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
