# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored and must NEVER be committed or included in a submission.

# Required for all GPT / OpenAI-embedding pipelines (baselines, ptd_model, rag profiler)
OPENAI_API_KEY=sk-your-key-here

# Required only for the Hugging Face inference pipelines (notebook/llama/*)
HF_TOKEN=hf_your-token-here
